<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.portfolio.DashboardController">

    <left>
        <VBox fx:id="sidebar"
              spacing="15"
              prefWidth="220">

            <padding>
                <Insets top="30" right="20" bottom="30" left="20"/>
            </padding>

            <children>

                <Label fx:id="logo"
                       text="DEVFOLIO"/>

                <Label fx:id="menuTitle"
                       text="MAIN MENU"/>

                <Button fx:id="dashboardButton"
                        text="⌂   Dashboard"
                        onAction="#showDashboard"/>

                <Button fx:id="projectsButton"
                        text="▣   Projects"
                        onAction="#showProjects"/>

                <Button fx:id="skillsButton"
                        text="★   Skills"
                        onAction="#showSkills"/>

                <Button fx:id="notesButton"
                        text="▤   Notes"
                        onAction="#showNotes"/>

                <Button fx:id="tasksButton"
                        text="✓   Tasks"
                        onAction="#showTasks"/>

                <Button fx:id="apiButton"
                        text="↗   API Data"
                        onAction="#showApi"/>

                <Button fx:id="settingsButton"
                        text="⚙   Settings"
                        onAction="#showSettings"/>

                <Button fx:id="updateProjectButton"
                        text="Update Project"
                        onAction="#updateProject"/>

                <Button fx:id="deleteProjectButton"
                        text="Delete Project"
                        onAction="#deleteProject"/>
            </children>

        </VBox>
    </left>

    <center>

        <VBox fx:id="content"
              spacing="15">

            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <children>

                <Label fx:id="pageTitle"
                       text="Projects"/>

                <Label fx:id="welcome"
                       text="Add a new project to your portfolio."/>

                <Label text="Project Title"/>

                <TextField fx:id="titleField"
                           promptText="Enter project title"/>

                <Label text="Description"/>

                <TextArea fx:id="descriptionField"
                          promptText="Describe your project"
                          prefHeight="80"/>

                <Label text="Technology"/>

                <TextField fx:id="technologyField"
                           promptText="Example: Java, C++, Arduino"/>

                <Label text="GitHub Link"/>

                <TextField fx:id="githubField"
                           promptText="Enter GitHub repository link"/>

                <Button fx:id="addProjectButton"
                        text="Add Project"
                        onAction="#addProject"/>

                <Label fx:id="projectMessage"/>

                <Label text="My Projects"/>

                <TableView fx:id="projectTable"
                           prefHeight="250">

                    <columns>

                        <TableColumn fx:id="titleColumn"
                                     text="Project Title"
                                     prefWidth="200"/>

                        <TableColumn fx:id="technologyColumn"
                                     text="Technology"
                                     prefWidth="180"/>

                        <TableColumn fx:id="githubColumn"
                                     text="GitHub Link"
                                     prefWidth="300"/>

                    </columns>

                </TableView>

                <Label text="Selected Project Details"/>

                <Label fx:id="detailTitle"
                       text="No project selected"/>

                <Label fx:id="detailTechnology"
                       text=""/>

                <Label fx:id="detailDescription"
                       text=""
                       wrapText="true"/>

                <Label fx:id="detailGithub"
                       text=""/>

            </children>

        </VBox>

    </center>

</BorderPane>