<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.geometry.Insets?>
        <?import javafx.scene.control.*?>
        <?import javafx.scene.image.ImageView?>
        <?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.portfolio.DashboardController">

    <!-- ===================================================== -->
    <!-- SIDEBAR -->
    <!-- ===================================================== -->

    <left>
        <VBox fx:id="sidebar"
              spacing="10"
              prefWidth="210">

            <padding>
                <Insets top="25"
                        right="15"
                        bottom="25"
                        left="15"/>
            </padding>

            <VBox spacing="5">

                <Label fx:id="logo"
                       text="DevFolio"/>

                <Label fx:id="menuTitle"
                       text="Personal Portfolio Manager"/>

            </VBox>

            <Button fx:id="dashboardButton"
                    text="Dashboard"
                    onAction="#showDashboard"
                    maxWidth="Infinity"/>

            <Button fx:id="projectsButton"
                    text="Projects"
                    onAction="#showProjects"
                    maxWidth="Infinity"/>

            <Button fx:id="skillsButton"
                    text="Skills"
                    onAction="#showSkills"
                    maxWidth="Infinity"/>

            <Button fx:id="notesButton"
                    text="Notes"
                    onAction="#showNotes"
                    maxWidth="Infinity"/>

            <Button fx:id="tasksButton"
                    text="Tasks"
                    onAction="#showTasks"
                    maxWidth="Infinity"/>

            <Button fx:id="apiButton"
                    text="API"
                    onAction="#showApi"
                    maxWidth="Infinity"/>

            <Button fx:id="settingsButton"
                    text="Settings"
                    onAction="#showSettings"
                    maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="Personal Portfolio Manager"
                   wrapText="true"/>

        </VBox>

    </left>


    <!-- ===================================================== -->
    <!-- MAIN CONTENT -->
    <!-- ===================================================== -->

    <center>

        <ScrollPane fitToWidth="true"
                    fitToHeight="false"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">

            <content>

                <VBox fx:id="content"
                      spacing="15">

                    <padding>
                        <Insets top="20"
                                right="25"
                                bottom="20"
                                left="25"/>
                    </padding>


                    <!-- ================================================= -->
                    <!-- MENU BAR -->
                    <!-- ================================================= -->

                    <MenuBar>

                        <Menu text="File">

                            <MenuItem text="Choose Profile Image"
                                      onAction="#chooseImage"/>

                            <SeparatorMenuItem/>

                            <MenuItem text="Exit"
                                      onAction="#exitApplication"/>

                        </Menu>


                        <Menu text="View">

                            <MenuItem text="Dashboard"
                                      onAction="#showDashboard"/>

                            <MenuItem text="Projects"
                                      onAction="#showProjects"/>

                            <MenuItem text="Skills"
                                      onAction="#showSkills"/>

                            <MenuItem text="Notes"
                                      onAction="#showNotes"/>

                            <MenuItem text="Tasks"
                                      onAction="#showTasks"/>

                            <MenuItem text="API"
                                      onAction="#showApi"/>

                            <MenuItem text="Settings"
                                      onAction="#showSettings"/>

                        </Menu>


                        <Menu text="Help">

                            <MenuItem text="About"
                                      onAction="#showAbout"/>

                        </Menu>

                    </MenuBar>


                    <!-- ================================================= -->
                    <!-- COMMON HEADER -->
                    <!-- ================================================= -->

                    <HBox spacing="15"
                          alignment="CENTER_LEFT">

                        <ImageView fx:id="profileImage"
                                   fitWidth="80"
                                   fitHeight="80"
                                   preserveRatio="true"/>

                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS">

                            <Label fx:id="pageTitle"
                                   text="Dashboard"/>

                            <Label fx:id="welcome"
                                   text="Welcome to your personal portfolio manager"
                                   wrapText="true"/>

                        </VBox>

                    </HBox>


                    <Separator/>


                    <!-- ================================================= -->
                    <!-- PAGE CONTAINER -->
                    <!-- ================================================= -->

                    <StackPane fx:id="pageContainer"
                               maxWidth="Infinity">


                        <!-- ================================================= -->
                        <!-- DASHBOARD -->
                        <!-- ================================================= -->

                        <VBox fx:id="dashboardPage"
                              spacing="15"
                              maxWidth="Infinity">

                            <Label text="Portfolio Overview"/>

                            <Label text="Welcome to DevFolio. Use the sidebar to manage your portfolio."
                                   wrapText="true"/>


                            <TitledPane text="Portfolio Tools"
                                        expanded="true"
                                        maxWidth="Infinity">

                                <content>

                                    <VBox spacing="12">

                                        <padding>
                                            <Insets top="15"
                                                    right="15"
                                                    bottom="15"
                                                    left="15"/>
                                        </padding>


                                        <HBox spacing="10"
                                              alignment="CENTER_LEFT">

                                            <Label text="Technology:"/>

                                            <ComboBox fx:id="technologyComboBox"
                                                      promptText="Select technology"
                                                      prefWidth="250"/>

                                        </HBox>


                                        <HBox spacing="10"
                                              alignment="CENTER_LEFT">

                                            <Label text="Category:"/>

                                            <ChoiceBox fx:id="categoryChoiceBox"
                                                       prefWidth="200"/>

                                        </HBox>


                                        <HBox spacing="10"
                                              alignment="CENTER_LEFT">

                                            <Label text="Project Date:"/>

                                            <DatePicker fx:id="projectDatePicker"/>

                                        </HBox>


                                        <HBox spacing="10"
                                              alignment="CENTER_LEFT">

                                            <Label text="Priority:"/>

                                            <RadioButton fx:id="lowPriority"
                                                         text="Low"/>

                                            <RadioButton fx:id="mediumPriority"
                                                         text="Medium"/>

                                            <RadioButton fx:id="highPriority"
                                                         text="High"/>

                                        </HBox>


                                        <CheckBox fx:id="featuredCheckBox"
                                                  text="Featured project"/>


                                        <HBox spacing="10"
                                              alignment="CENTER_LEFT">

                                            <Label text="Completion:"/>

                                            <Slider fx:id="completionSlider"
                                                    min="0"
                                                    max="100"
                                                    value="50"
                                                    HBox.hgrow="ALWAYS"/>

                                            <Label fx:id="completionLabel"
                                                   text="50%"/>

                                        </HBox>


                                        <HBox spacing="10"
                                              alignment="CENTER_LEFT">

                                            <Label text="Team Members:"/>

                                            <Spinner fx:id="teamSpinner"
                                                     prefWidth="100"/>

                                        </HBox>


                                        <HBox spacing="10"
                                              alignment="CENTER_LEFT">

                                            <Label text="Portfolio PIN:"/>

                                            <PasswordField fx:id="passwordField"
                                                           promptText="Enter PIN"/>

                                        </HBox>


                                        <Label text="Technology Categories"/>

                                        <TreeView fx:id="technologyTree"
                                                  prefHeight="130"/>


                                        <Label text="Selected Tools"/>

                                        <ListView fx:id="toolsList"
                                                  prefHeight="100"/>


                                        <Label text="Portfolio Completion"/>

                                        <ProgressBar fx:id="portfolioProgress"
                                                     progress="0.5"
                                                     maxWidth="Infinity"/>


                                        <HBox spacing="10">

                                            <Button text="Choose Profile Image"
                                                    onAction="#chooseImage"/>

                                            <Button text="Show About"
                                                    onAction="#showAbout"/>

                                        </HBox>

                                    </VBox>

                                </content>

                            </TitledPane>

                        </VBox>


                        <!-- ================================================= -->
                        <!-- PROJECTS -->
                        <!-- ================================================= -->

                        <VBox fx:id="projectsPage"
                              spacing="15"
                              maxWidth="Infinity">

                            <Label fx:id="projectFormTitle"
                                   text="Add / Edit Project"/>


                            <GridPane hgap="10"
                                      vgap="10">

                                <columnConstraints>

                                    <ColumnConstraints percentWidth="18"/>

                                    <ColumnConstraints percentWidth="82"
                                                       hgrow="ALWAYS"/>

                                </columnConstraints>


                                <Label fx:id="projectTitleLabel"
                                       text="Title:"
                                       GridPane.rowIndex="0"
                                       GridPane.columnIndex="0"/>

                                <TextField fx:id="titleField"
                                           promptText="Project title"
                                           maxWidth="Infinity"
                                           GridPane.rowIndex="0"
                                           GridPane.columnIndex="1"/>


                                <Label fx:id="descriptionLabel"
                                       text="Description:"
                                       GridPane.rowIndex="1"
                                       GridPane.columnIndex="0"/>

                                <TextArea fx:id="descriptionField"
                                          promptText="Project description"
                                          prefRowCount="2"
                                          maxWidth="Infinity"
                                          GridPane.rowIndex="1"
                                          GridPane.columnIndex="1"/>


                                <Label fx:id="technologyLabel"
                                       text="Technology:"
                                       GridPane.rowIndex="2"
                                       GridPane.columnIndex="0"/>

                                <TextField fx:id="technologyField"
                                           promptText="Technology"
                                           maxWidth="Infinity"
                                           GridPane.rowIndex="2"
                                           GridPane.columnIndex="1"/>


                                <Label fx:id="githubLabel"
                                       text="GitHub:"
                                       GridPane.rowIndex="3"
                                       GridPane.columnIndex="0"/>

                                <TextField fx:id="githubField"
                                           promptText="GitHub repository link"
                                           maxWidth="Infinity"
                                           GridPane.rowIndex="3"
                                           GridPane.columnIndex="1"/>

                            </GridPane>


                            <HBox spacing="10">

                                <Button fx:id="addProjectButton"
                                        text="Add Project"
                                        onAction="#addProject"/>

                                <Button fx:id="updateProjectButton"
                                        text="Update"
                                        onAction="#updateProject"/>

                                <Button fx:id="deleteProjectButton"
                                        text="Delete"
                                        onAction="#deleteProject"/>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Label fx:id="projectMessage"/>

                            </HBox>


                            <Separator/>


                            <Label fx:id="myProjectsLabel"
                                   text="My Projects"/>


                            <TableView fx:id="projectTable"
                                       prefHeight="260">

                                <columns>

                                    <TableColumn fx:id="titleColumn"
                                                 text="Title"
                                                 prefWidth="250"/>

                                    <TableColumn fx:id="technologyColumn"
                                                 text="Technology"
                                                 prefWidth="180"/>

                                    <TableColumn fx:id="githubColumn"
                                                 text="GitHub"
                                                 prefWidth="300"/>

                                </columns>

                            </TableView>


                            <VBox spacing="5">

                                <Label text="Selected Project"/>

                                <Label fx:id="detailTitle"/>

                                <Label fx:id="detailTechnology"/>

                                <Label fx:id="detailDescription"
                                       wrapText="true"/>

                                <Label fx:id="detailGithub"
                                       wrapText="true"/>

                            </VBox>

                        </VBox>


                        <!-- ================================================= -->
                        <!-- SKILLS -->
                        <!-- ================================================= -->

                        <VBox fx:id="skillsPage"
                              spacing="15"
                              maxWidth="Infinity">

                            <Label text="Skills"/>

                            <Label text="Create, update and connect your technical skills to projects."
                                   wrapText="true"/>


                            <Separator/>


                            <!-- SKILL FORM -->

                            <TitledPane text="Skill Information"
                                        expanded="true"
                                        maxWidth="Infinity">

                                <content>

                                    <GridPane hgap="10"
                                              vgap="12">

                                        <padding>
                                            <Insets top="15"
                                                    right="15"
                                                    bottom="15"
                                                    left="15"/>
                                        </padding>


                                        <columnConstraints>

                                            <ColumnConstraints percentWidth="20"/>

                                            <ColumnConstraints percentWidth="80"
                                                               hgrow="ALWAYS"/>

                                        </columnConstraints>


                                        <Label text="Skill Name:"
                                               GridPane.rowIndex="0"
                                               GridPane.columnIndex="0"/>

                                        <TextField fx:id="skillNameField"
                                                   promptText="e.g. Java"
                                                   maxWidth="Infinity"
                                                   GridPane.rowIndex="0"
                                                   GridPane.columnIndex="1"/>


                                        <Label text="Category:"
                                               GridPane.rowIndex="1"
                                               GridPane.columnIndex="0"/>

                                        <TextField fx:id="skillCategoryField"
                                                   promptText="e.g. Programming"
                                                   maxWidth="Infinity"
                                                   GridPane.rowIndex="1"
                                                   GridPane.columnIndex="1"/>


                                        <Label text="Skill Level:"
                                               GridPane.rowIndex="2"
                                               GridPane.columnIndex="0"/>

                                        <HBox spacing="10"
                                              alignment="CENTER_LEFT"
                                              GridPane.rowIndex="2"
                                              GridPane.columnIndex="1">

                                            <Slider fx:id="skillLevelSlider"
                                                    min="0"
                                                    max="100"
                                                    value="50"
                                                    HBox.hgrow="ALWAYS"/>

                                            <Label fx:id="skillLevelLabel"
                                                   text="50%"/>

                                        </HBox>

                                    </GridPane>

                                </content>

                            </TitledPane>


                            <!-- SKILL BUTTONS -->

                            <HBox spacing="10">

                                <Button fx:id="addSkillButton"
                                        text="Add Skill"
                                        onAction="#addSkill"/>

                                <Button fx:id="updateSkillButton"
                                        text="Update"
                                        onAction="#updateSkill"/>

                                <Button fx:id="deleteSkillButton"
                                        text="Delete"
                                        onAction="#deleteSkill"/>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Label text="Select a skill to edit it."/>

                            </HBox>


                            <Separator/>


                            <!-- SKILL LIST -->

                            <Label text="All Skills"/>

                            <ListView fx:id="skillListView"
                                      prefHeight="180"
                                      maxWidth="Infinity"/>


                            <Separator/>


                            <!-- PROJECT SKILLS -->

                            <TitledPane text="Project Skills"
                                        expanded="true"
                                        maxWidth="Infinity">

                                <content>

                                    <VBox spacing="10">

                                        <padding>
                                            <Insets top="15"
                                                    right="15"
                                                    bottom="15"
                                                    left="15"/>
                                        </padding>


                                        <Label text="First select a project from the Projects page, then select a skill above."/>

                                        <Button fx:id="assignSkillButton"
                                                text="Assign Selected Skill To Selected Project"
                                                onAction="#assignSkillToProject"/>


                                        <Label text="Skills belonging to the selected project:"/>


                                        <ListView fx:id="projectSkillListView"
                                                  prefHeight="150"
                                                  maxWidth="Infinity"/>

                                    </VBox>

                                </content>

                            </TitledPane>

                        </VBox>


                        <!-- ================================================= -->
                        <!-- NOTES -->
                        <!-- ================================================= -->

                        <VBox fx:id="notesPage"
                              spacing="15"
                              maxWidth="Infinity">

                            <Label text="Notes"/>

                            <Label text="Create and manage notes for your portfolio."
                                   wrapText="true"/>


                            <Separator/>


                            <HBox spacing="15"
                                  maxWidth="Infinity">


                                <!-- NOTE LIST -->

                                <VBox spacing="10"
                                      prefWidth="280">

                                    <Label text="My Notes"/>

                                    <ListView fx:id="noteListView"
                                              prefHeight="400"
                                              VBox.vgrow="ALWAYS"/>

                                </VBox>


                                <!-- NOTE EDITOR -->

                                <VBox spacing="10"
                                      HBox.hgrow="ALWAYS">

                                    <Label text="Note Title"/>

                                    <TextField fx:id="noteTitleField"
                                               promptText="Enter note title"
                                               maxWidth="Infinity"/>


                                    <Label text="Note Content"/>

                                    <TextArea fx:id="noteContentArea"
                                              promptText="Write your note here..."
                                              wrapText="true"
                                              prefRowCount="14"
                                              maxWidth="Infinity"
                                              VBox.vgrow="ALWAYS"/>


                                    <HBox spacing="10">

                                        <Button fx:id="addNoteButton"
                                                text="Add Note"
                                                onAction="#addNote"/>

                                        <Button fx:id="updateNoteButton"
                                                text="Update"
                                                onAction="#updateNote"/>

                                        <Button fx:id="deleteNoteButton"
                                                text="Delete"
                                                onAction="#deleteNote"/>

                                    </HBox>

                                </VBox>

                            </HBox>

                        </VBox>


                        <!-- ================================================= -->
                        <!-- TASKS -->
                        <!-- ================================================= -->

                        <VBox fx:id="tasksPage"
                              spacing="15"
                              maxWidth="Infinity">

                            <Label text="Tasks"/>

                            <Label text="Track tasks related to your portfolio."
                                   wrapText="true"/>


                            <Separator/>


                            <HBox spacing="15"
                                  maxWidth="Infinity">


                                <!-- TASK LIST -->

                                <VBox spacing="10"
                                      prefWidth="300">

                                    <Label text="My Tasks"/>

                                    <ListView fx:id="taskListView"
                                              prefHeight="350"
                                              VBox.vgrow="ALWAYS"/>

                                </VBox>


                                <!-- TASK EDITOR -->

                                <VBox spacing="12"
                                      HBox.hgrow="ALWAYS">

                                    <Label text="Task Title"/>

                                    <TextField fx:id="taskTitleField"
                                               promptText="Enter task title"
                                               maxWidth="Infinity"/>


                                    <CheckBox fx:id="taskCompletedCheckBox"
                                              text="Completed"/>


                                    <HBox spacing="10">

                                        <Button fx:id="addTaskButton"
                                                text="Add Task"
                                                onAction="#addTask"/>

                                        <Button fx:id="updateTaskButton"
                                                text="Update"
                                                onAction="#updateTask"/>

                                        <Button fx:id="deleteTaskButton"
                                                text="Delete"
                                                onAction="#deleteTask"/>

                                    </HBox>


                                    <Separator/>


                                    <Button fx:id="toggleTaskButton"
                                            text="Mark Complete / Incomplete"
                                            onAction="#toggleTask"/>

                                </VBox>

                            </HBox>

                        </VBox>


                        <!-- ================================================= -->
                        <!-- API -->
                        <!-- ================================================= -->

                        <VBox fx:id="apiPage"
                              spacing="15"
                              maxWidth="Infinity">

                            <Label text="External API"/>

                            <Label text="HTTP Request + JSON Parsing"/>

                            <Button fx:id="fetchApiButton"
                                    text="Fetch API Data"
                                    onAction="#fetchApiData"/>

                            <Label fx:id="apiStatusLabel"
                                   text="Status: Ready"/>

                            <TextArea fx:id="apiResultArea"
                                      promptText="API response will appear here..."
                                      prefRowCount="12"
                                      wrapText="true"
                                      maxWidth="Infinity"/>

                            <ProgressBar fx:id="apiProgress"
                                         progress="0"
                                         maxWidth="Infinity"/>

                        </VBox>


                        <!-- ================================================= -->
                        <!-- SETTINGS -->
                        <!-- ================================================= -->

                        <VBox fx:id="settingsPage"
                              spacing="15"
                              maxWidth="Infinity">

                            <Label text="Settings"/>

                            <Label text="Application Settings"/>

                            <Separator/>

                            <Button text="Choose Profile Image"
                                    onAction="#chooseImage"/>

                            <Button text="Show About"
                                    onAction="#showAbout"/>

                            <Label text="DevFolio - Personal Portfolio Manager"
                                   wrapText="true"/>

                        </VBox>


                    </StackPane>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>