<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.geometry.Insets?>
        <?import javafx.scene.control.*?>
        <?import javafx.scene.image.ImageView?>
        <?import javafx.scene.layout.*?>
        <?import javafx.scene.chart.*?>

<BorderPane fx:id="rootBorderPane"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.portfolio.DashboardController">

    <!-- ===================================================== -->
    <!-- SIDEBAR (Collapsible Drawer - Not Always Visible) -->
    <!-- ===================================================== -->

    <left>
        <VBox fx:id="sidebar"
              spacing="10"
              prefWidth="210"
              visible="false"
              managed="false">

            <padding>
                <Insets top="25"
                        right="15"
                        bottom="25"
                        left="15"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="8">
                <VBox spacing="5" HBox.hgrow="ALWAYS">

                    <Label fx:id="logo"
                           text="DevFolio"/>

                    <Label fx:id="menuTitle"
                           text="Personal Portfolio Manager"/>

                </VBox>

                <Button fx:id="closeSidebarButton"
                        text="✕"
                        onAction="#toggleSidebar"/>
            </HBox>

            <Button fx:id="welcomeButton"
                    text="Welcome"
                    onAction="#showWelcome"
                    maxWidth="Infinity"/>

            <Button fx:id="dashboardButton"
                    text="Dashboard"
                    onAction="#showDashboard"
                    maxWidth="Infinity"/>

            <Button fx:id="projectsButton"
                    text="Projects"
                    onAction="#showProjects"
                    maxWidth="Infinity"/>

            <Button fx:id="skillsButton"
                    text="Skills"
                    onAction="#showSkills"
                    maxWidth="Infinity"/>

            <Button fx:id="notesButton"
                    text="Notes"
                    onAction="#showNotes"
                    maxWidth="Infinity"/>

            <Button fx:id="tasksButton"
                    text="Tasks"
                    onAction="#showTasks"
                    maxWidth="Infinity"/>

            <Button fx:id="apiButton"
                    text="API"
                    onAction="#showApi"
                    maxWidth="Infinity"/>

            <Button fx:id="settingsButton"
                    text="Settings"
                    onAction="#showSettings"
                    maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="Personal Portfolio Manager"
                   wrapText="true"/>

        </VBox>

    </left>


    <!-- ===================================================== -->
    <!-- MAIN CONTENT -->
    <!-- ===================================================== -->

    <center>

        <ScrollPane fx:id="mainScrollPane"
                    fitToWidth="true"
                    fitToHeight="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">

            <content>

                <VBox fx:id="content"
                      spacing="15"
                      maxWidth="Infinity">

                    <padding>
                        <Insets top="20"
                                right="25"
                                bottom="20"
                                left="25"/>
                    </padding>


                    <!-- ================================================= -->
                    <!-- MENU BAR -->
                    <!-- ================================================= -->

                    <MenuBar>

                        <Menu text="File">

                            <MenuItem text="Choose Profile Image"
                                      onAction="#chooseImage"/>

                            <MenuItem text="Preview Selected in New Window"
                                      onAction="#openProjectPreviewWindow"/>

                            <SeparatorMenuItem/>

                            <MenuItem text="Exit"
                                      onAction="#exitApplication"/>

                        </Menu>


                        <Menu text="View">

                            <MenuItem text="Toggle Sidebar Menu"
                                      onAction="#toggleSidebar"/>

                            <SeparatorMenuItem/>

                            <MenuItem text="Welcome"
                                      onAction="#showWelcome"/>

                            <MenuItem text="Dashboard"
                                      onAction="#showDashboard"/>

                            <MenuItem text="Projects"
                                      onAction="#showProjects"/>

                            <MenuItem text="Skills"
                                      onAction="#showSkills"/>

                            <MenuItem text="Notes"
                                      onAction="#showNotes"/>

                            <MenuItem text="Tasks"
                                      onAction="#showTasks"/>

                            <MenuItem text="API"
                                      onAction="#showApi"/>

                            <MenuItem text="Settings"
                                      onAction="#showSettings"/>

                        </Menu>


                        <Menu text="Help">

                            <MenuItem text="About"
                                      onAction="#showAbout"/>

                        </Menu>

                    </MenuBar>


                    <!-- ================================================= -->
                    <!-- WEBSITE TOP NAVIGATION BAR -->
                    <!-- ================================================= -->

                    <HBox fx:id="topNavBar"
                          spacing="8"
                          alignment="CENTER_LEFT">

                        <Button fx:id="sidebarToggleButton"
                                text="☰ Menu"
                                onAction="#toggleSidebar"/>

                        <Separator orientation="VERTICAL"/>

                        <Button fx:id="topWelcomeBtn"
                                text="Home"
                                onAction="#showWelcome"/>

                        <Button fx:id="topDashboardBtn"
                                text="Dashboard"
                                onAction="#showDashboard"/>

                        <Button fx:id="topProjectsBtn"
                                text="Projects"
                                onAction="#showProjects"/>

                        <Button fx:id="topSkillsBtn"
                                text="Skills"
                                onAction="#showSkills"/>

                        <Button fx:id="topNotesBtn"
                                text="Notes"
                                onAction="#showNotes"/>

                        <Button fx:id="topTasksBtn"
                                text="Tasks"
                                onAction="#showTasks"/>

                        <Button fx:id="topApiBtn"
                                text="API"
                                onAction="#showApi"/>

                        <Button fx:id="topSettingsBtn"
                                text="Settings"
                                onAction="#showSettings"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <HBox spacing="8"
                              alignment="CENTER_RIGHT">

                            <Button fx:id="prevPageButton"
                                    text="◀ Prev"
                                    onAction="#showPreviousPage"/>

                            <Label fx:id="pageIndicatorLabel"
                                   text="1 / 8 : Welcome"/>

                            <Button fx:id="nextPageButton"
                                    text="Next ▶"
                                    onAction="#showNextPage"/>

                        </HBox>

                    </HBox>


                    <!-- ================================================= -->
                    <!-- PAGE BANNER HEADER -->
                    <!-- ================================================= -->

                    <HBox fx:id="pageHeaderBox"
                          spacing="15"
                          alignment="CENTER_LEFT">

                        <ImageView fx:id="profileImage"
                                   fitWidth="80"
                                   fitHeight="80"
                                   preserveRatio="true"/>

                        <VBox spacing="5"
                              HBox.hgrow="ALWAYS">

                            <Label fx:id="pageTitle"
                                   text="Dashboard"/>

                            <Label fx:id="welcome"
                                   text="Welcome to your personal portfolio manager"
                                   wrapText="true"/>

                        </VBox>

                    </HBox>


                    <Separator/>


                    <!-- ================================================= -->
                    <!-- PAGE CONTAINER -->
                    <!-- ================================================= -->

                    <StackPane fx:id="pageContainer"
                               maxWidth="Infinity"
                               VBox.vgrow="ALWAYS">


                        <!-- ================================================= -->
                        <!-- WELCOME PAGE (Stage 31 Welcome Experience) -->
                        <!-- ================================================= -->

                        <VBox fx:id="welcomePage"
                              spacing="20"
                              maxWidth="Infinity"
                              VBox.vgrow="ALWAYS">

                            <!-- HERO BANNER -->
                            <VBox fx:id="welcomeHero"
                                  spacing="14">

                                <padding>
                                    <Insets top="25"
                                            right="25"
                                            bottom="25"
                                            left="25"/>
                                </padding>

                                <Label fx:id="welcomeHeading"
                                       text="Welcome to DevFolio 👋"/>

                                <Label fx:id="welcomeSubheading"
                                       text="Your centralized personal portfolio and desktop engineering workstation. Organize software projects, quantify your technical skills, save developer notes, and test external APIs effortlessly."
                                       wrapText="true"/>

                                <HBox spacing="12"
                                      alignment="CENTER_LEFT">

                                    <Button fx:id="welcomeDashBtn"
                                            text="📊 Go to Dashboard"
                                            onAction="#showDashboard"/>

                                    <Button fx:id="welcomeProjBtn"
                                            text="📁 Manage Projects"
                                            onAction="#showProjects"/>

                                    <Button fx:id="welcomeSkillsBtn"
                                            text="⚡ Manage Skills"
                                            onAction="#showSkills"/>

                                    <Button fx:id="welcomeNotesBtn"
                                            text="📝 Quick Notes"
                                            onAction="#showNotes"/>

                                    <Button fx:id="welcomeTasksBtn"
                                            text="✅ View Tasks"
                                            onAction="#showTasks"/>

                                </HBox>

                            </VBox>


                            <!-- FEATURES HIGHLIGHT (Stage 8 FlowPane layout) -->
                            <Label fx:id="welcomeFeaturesTitle"
                                   text="Core Capabilities &amp; Architecture"/>

                            <FlowPane hgap="16"
                                      vgap="16"
                                      maxWidth="Infinity">

                                <VBox fx:id="featureCard1"
                                      prefWidth="260"
                                      spacing="8">
                                    <padding>
                                        <Insets top="16" right="16" bottom="16" left="16"/>
                                    </padding>
                                    <Label fx:id="featureTitle1"
                                           text="📁 Project Workstation"/>
                                    <Label text="Document project repositories, technology stacks, and associate competencies with SQLite persistence."
                                           wrapText="true"/>
                                </VBox>

                                <VBox fx:id="featureCard2"
                                      prefWidth="260"
                                      spacing="8">
                                    <padding>
                                        <Insets top="16" right="16" bottom="16" left="16"/>
                                    </padding>
                                    <Label fx:id="featureTitle2"
                                           text="⚡ Technical Skills Matrix"/>
                                    <Label text="Quantify proficiencies from 0 to 100%, group by categories, and associate with projects via many-to-many relations."
                                           wrapText="true"/>
                                </VBox>

                                <VBox fx:id="featureCard3"
                                      prefWidth="260"
                                      spacing="8">
                                    <padding>
                                        <Insets top="16" right="16" bottom="16" left="16"/>
                                    </padding>
                                    <Label fx:id="featureTitle3"
                                           text="📝 Productivity &amp; Todo"/>
                                    <Label text="Capture ideas, technical notes, and maintain task items with instant completion status toggling."
                                           wrapText="true"/>
                                </VBox>

                                <VBox fx:id="featureCard4"
                                      prefWidth="260"
                                      spacing="8">
                                    <padding>
                                        <Insets top="16" right="16" bottom="16" left="16"/>
                                    </padding>
                                    <Label fx:id="featureTitle4"
                                           text="🌐 REST API &amp; Multithreading"/>
                                    <Label text="Demonstrates background worker threads and thread pools using Java HttpClient and Gson parser."
                                           wrapText="true"/>
                                </VBox>

                            </FlowPane>


                            <!-- SYSTEM STATUS -->
                            <HBox spacing="20"
                                  alignment="CENTER_LEFT">

                                <Label fx:id="dbStatusBadge"
                                       text="● Database: SQLite portfolio.db Connected"/>

                                <Label fx:id="systemUptimeLabel"
                                       text="● Engine: JavaFX 21 on Java 17+"/>

                            </HBox>

                        </VBox>


                        <!-- ================================================= -->
                        <!-- DASHBOARD (Stage 31 Beautiful Polished Dashboard) -->
                        <!-- ================================================= -->

                        <VBox fx:id="dashboardPage"
                              spacing="18"
                              maxWidth="Infinity">

                            <!-- DASHBOARD TOP HEADER & LIVE THREAD CLOCK (Stage 26) -->
                            <HBox spacing="15"
                                  alignment="CENTER_LEFT">

                                <VBox spacing="4"
                                      HBox.hgrow="ALWAYS">

                                    <Label fx:id="dashOverviewTitle"
                                           text="Portfolio Analytics &amp; Control Hub"/>

                                    <Label fx:id="dashOverviewSubtitle"
                                           text="Live overview synchronized with local SQLite database."/>

                                </VBox>

                                <VBox alignment="CENTER_RIGHT"
                                      spacing="3">

                                    <Label fx:id="liveClockLabel"
                                           text="Syncing clock..."/>

                                    <Label fx:id="systemStatusBadge"
                                           text="● Background Daemon Active"/>

                                </VBox>

                            </HBox>


                            <!-- 4 KPI STATISTIC CARDS (Stage 31) -->
                            <HBox spacing="15"
                                  maxWidth="Infinity">

                                <!-- CARD 1: PROJECTS -->
                                <VBox fx:id="statCard1"
                                      spacing="6"
                                      HBox.hgrow="ALWAYS">

                                    <padding>
                                        <Insets top="16" right="16" bottom="16" left="16"/>
                                    </padding>

                                    <Label fx:id="statLabel1"
                                           text="TOTAL PROJECTS"/>

                                    <Label fx:id="statProjectsCount"
                                           text="0"/>

                                    <Label fx:id="statSub1"
                                           text="Active software repositories"/>

                                </VBox>

                                <!-- CARD 2: SKILLS -->
                                <VBox fx:id="statCard2"
                                      spacing="6"
                                      HBox.hgrow="ALWAYS">

                                    <padding>
                                        <Insets top="16" right="16" bottom="16" left="16"/>
                                    </padding>

                                    <Label fx:id="statLabel2"
                                           text="TOTAL SKILLS"/>

                                    <Label fx:id="statSkillsCount"
                                           text="0"/>

                                    <Label fx:id="statSub2"
                                           text="Technical proficiencies"/>

                                </VBox>

                                <!-- CARD 3: NOTES -->
                                <VBox fx:id="statCard3"
                                      spacing="6"
                                      HBox.hgrow="ALWAYS">

                                    <padding>
                                        <Insets top="16" right="16" bottom="16" left="16"/>
                                    </padding>

                                    <Label fx:id="statLabel3"
                                           text="SAVED NOTES"/>

                                    <Label fx:id="statNotesCount"
                                           text="0"/>

                                    <Label fx:id="statSub3"
                                           text="Developer notes"/>

                                </VBox>

                                <!-- CARD 4: TASKS -->
                                <VBox fx:id="statCard4"
                                      spacing="6"
                                      HBox.hgrow="ALWAYS">

                                    <padding>
                                        <Insets top="16" right="16" bottom="16" left="16"/>
                                    </padding>

                                    <Label fx:id="statLabel4"
                                           text="ACTIVE TASKS"/>

                                    <Label fx:id="statTasksCount"
                                           text="0 / 0"/>

                                    <Label fx:id="statSub4"
                                           text="Completed / Total tasks"/>

                                </VBox>

                            </HBox>


                            <!-- QUICK ACTIONS (Stage 18 & 19) -->
                            <HBox spacing="15"
                                  alignment="CENTER_LEFT">

                                <Button fx:id="openPreviewButton"
                                        text="🔍 Preview Selected in New Window"
                                        onAction="#openProjectPreviewWindow"/>

                            </HBox>


                            <!-- PORTFOLIO TOOLS -->
                            <TitledPane text="Portfolio Configuration &amp; Interactive Controls"
                                        expanded="true"
                                        maxWidth="Infinity">

                                <content>

                                    <VBox spacing="14">

                                        <padding>
                                            <Insets top="15"
                                                    right="15"
                                                    bottom="15"
                                                    left="15"/>
                                        </padding>


                                        <HBox spacing="10"
                                              alignment="CENTER_LEFT">

                                            <Label text="Technology:"/>

                                            <ComboBox fx:id="technologyComboBox"
                                                      promptText="Select technology"
                                                      prefWidth="250"/>

                                        </HBox>


                                        <HBox spacing="10"
                                              alignment="CENTER_LEFT">

                                            <Label text="Category:"/>

                                            <ChoiceBox fx:id="categoryChoiceBox"
                                                       prefWidth="200"/>

                                        </HBox>


                                        <!-- Stage 12: DatePicker + DateFormatter -->
                                        <HBox spacing="10"
                                              alignment="CENTER_LEFT">

                                            <Label text="Project Date:"/>

                                            <DatePicker fx:id="projectDatePicker"/>

                                            <Label fx:id="formattedDateLabel"
                                                   text="No date selected"/>

                                        </HBox>


                                        <HBox spacing="10"
                                              alignment="CENTER_LEFT">

                                            <Label text="Priority:"/>

                                            <RadioButton fx:id="lowPriority"
                                                         text="Low"/>

                                            <RadioButton fx:id="mediumPriority"
                                                         text="Medium"/>

                                            <RadioButton fx:id="highPriority"
                                                         text="High"/>

                                        </HBox>


                                        <CheckBox fx:id="featuredCheckBox"
                                                  text="Featured project"/>


                                        <HBox spacing="10"
                                              alignment="CENTER_LEFT">

                                            <Label text="Completion:"/>

                                            <Slider fx:id="completionSlider"
                                                    min="0"
                                                    max="100"
                                                    value="50"
                                                    HBox.hgrow="ALWAYS"/>

                                            <Label fx:id="completionLabel"
                                                   text="50%"/>

                                        </HBox>


                                        <HBox spacing="10"
                                              alignment="CENTER_LEFT">

                                            <Label text="Team Members:"/>

                                            <Spinner fx:id="teamSpinner"
                                                     prefWidth="100"/>

                                        </HBox>


                                        <HBox spacing="10"
                                              alignment="CENTER_LEFT">

                                            <Label text="Portfolio PIN:"/>

                                            <PasswordField fx:id="passwordField"
                                                           promptText="Enter PIN"/>

                                        </HBox>


                                        <!-- Stage 8: Technology Tags (FlowPane) -->
                                        <VBox spacing="6">

                                            <Label text="Technology Stack Badges (FlowPane):"/>

                                            <FlowPane hgap="8"
                                                      vgap="8"
                                                      fx:id="techBadgesPane"/>

                                        </VBox>


                                        <Label text="Technology Categories"/>

                                        <TreeView fx:id="technologyTree"
                                                  prefHeight="130"/>


                                        <Label text="Selected Tools"/>

                                        <ListView fx:id="toolsList"
                                                  prefHeight="100"/>


                                        <Label text="Portfolio Completion"/>

                                        <ProgressBar fx:id="portfolioProgress"
                                                     progress="0.5"
                                                     maxWidth="Infinity"/>


                                        <HBox spacing="10">

                                            <Button text="Choose Profile Image"
                                                    onAction="#chooseImage"/>

                                            <Button text="Show About"
                                                    onAction="#showAbout"/>

                                        </HBox>

                                    </VBox>

                                </content>

                            </TitledPane>

                        </VBox>


                        <!-- ================================================= -->
                        <!-- PROJECTS -->
                        <!-- ================================================= -->

                        <VBox fx:id="projectsPage"
                              spacing="15"
                              maxWidth="Infinity">

                            <Label fx:id="projectFormTitle"
                                   text="Add / Edit Project"/>


                            <GridPane hgap="10"
                                      vgap="10">

                                <columnConstraints>

                                    <ColumnConstraints percentWidth="18"/>

                                    <ColumnConstraints percentWidth="82"
                                                       hgrow="ALWAYS"/>

                                </columnConstraints>


                                <Label fx:id="projectTitleLabel"
                                       text="Title:"
                                       GridPane.rowIndex="0"
                                       GridPane.columnIndex="0"/>

                                <TextField fx:id="titleField"
                                           promptText="Project title"
                                           maxWidth="Infinity"
                                           GridPane.rowIndex="0"
                                           GridPane.columnIndex="1"/>


                                <Label fx:id="descriptionLabel"
                                       text="Description:"
                                       GridPane.rowIndex="1"
                                       GridPane.columnIndex="0"/>

                                <TextArea fx:id="descriptionField"
                                          promptText="Project description"
                                          prefRowCount="2"
                                          maxWidth="Infinity"
                                          GridPane.rowIndex="1"
                                          GridPane.columnIndex="1"/>


                                <Label fx:id="technologyLabel"
                                       text="Technology:"
                                       GridPane.rowIndex="2"
                                       GridPane.columnIndex="0"/>

                                <TextField fx:id="technologyField"
                                           promptText="Technology"
                                           maxWidth="Infinity"
                                           GridPane.rowIndex="2"
                                           GridPane.columnIndex="1"/>


                                <Label fx:id="githubLabel"
                                       text="GitHub:"
                                       GridPane.rowIndex="3"
                                       GridPane.columnIndex="0"/>

                                <TextField fx:id="githubField"
                                           promptText="GitHub repository link"
                                           maxWidth="Infinity"
                                           GridPane.rowIndex="3"
                                           GridPane.columnIndex="1"/>

                            </GridPane>


                            <HBox spacing="10">

                                <Button fx:id="addProjectButton"
                                        text="Add Project"
                                        onAction="#addProject"/>

                                <Button fx:id="updateProjectButton"
                                        text="Update"
                                        onAction="#updateProject"/>

                                <Button fx:id="deleteProjectButton"
                                        text="Delete"
                                        onAction="#deleteProject"/>

                                <Button fx:id="previewProjectButton"
                                        text="Preview in Window"
                                        onAction="#openProjectPreviewWindow"/>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Label fx:id="projectMessage"/>

                            </HBox>


                            <Separator/>


                            <HBox spacing="15"
                                  alignment="CENTER_LEFT">

                                <Label fx:id="myProjectsLabel"
                                       text="My Projects"/>

                                <Region HBox.hgrow="ALWAYS"/>

                                <TextField fx:id="projectSearchField"
                                           promptText="🔍 Search projects by title, tech, or description..."
                                           prefWidth="360"/>

                                <Button fx:id="clearSearchButton"
                                        text="Clear"
                                        onAction="#clearProjectSearch"/>

                            </HBox>


                            <TableView fx:id="projectTable"
                                       prefHeight="260">

                                <columns>

                                    <TableColumn fx:id="titleColumn"
                                                 text="Title"
                                                 prefWidth="250"/>

                                    <TableColumn fx:id="technologyColumn"
                                                 text="Technology"
                                                 prefWidth="180"/>

                                    <TableColumn fx:id="githubColumn"
                                                 text="GitHub"
                                                 prefWidth="300"/>

                                </columns>

                            </TableView>


                            <VBox spacing="5">

                                <Label text="Selected Project"/>

                                <Label fx:id="detailTitle"/>

                                <Label fx:id="detailTechnology"/>

                                <Label fx:id="detailDescription"
                                       wrapText="true"/>

                                <Label fx:id="detailGithub"
                                       wrapText="true"/>

                            </VBox>

                        </VBox>


                        <!-- ================================================= -->
                        <!-- SKILLS -->
                        <!-- ================================================= -->

                        <VBox fx:id="skillsPage"
                              spacing="15"
                              maxWidth="Infinity">

                            <Label text="Skills"/>

                            <Label text="Create, update and connect your technical skills to projects."
                                   wrapText="true"/>


                            <Separator/>


                            <!-- SKILL FORM -->

                            <TitledPane text="Skill Information"
                                        expanded="true"
                                        maxWidth="Infinity">

                                <content>

                                    <GridPane hgap="10"
                                              vgap="12">

                                        <padding>
                                            <Insets top="15"
                                                    right="15"
                                                    bottom="15"
                                                    left="15"/>
                                        </padding>


                                        <columnConstraints>

                                            <ColumnConstraints percentWidth="20"/>

                                            <ColumnConstraints percentWidth="80"
                                                               hgrow="ALWAYS"/>

                                        </columnConstraints>


                                        <Label text="Skill Name:"
                                               GridPane.rowIndex="0"
                                               GridPane.columnIndex="0"/>

                                        <TextField fx:id="skillNameField"
                                                   promptText="e.g. Java"
                                                   maxWidth="Infinity"
                                                   GridPane.rowIndex="0"
                                                   GridPane.columnIndex="1"/>


                                        <Label text="Category:"
                                               GridPane.rowIndex="1"
                                               GridPane.columnIndex="0"/>

                                        <TextField fx:id="skillCategoryField"
                                                   promptText="e.g. Programming"
                                                   maxWidth="Infinity"
                                                   GridPane.rowIndex="1"
                                                   GridPane.columnIndex="1"/>


                                        <Label text="Skill Level:"
                                               GridPane.rowIndex="2"
                                               GridPane.columnIndex="0"/>

                                        <HBox spacing="10"
                                              alignment="CENTER_LEFT"
                                              GridPane.rowIndex="2"
                                              GridPane.columnIndex="1">

                                            <Slider fx:id="skillLevelSlider"
                                                    min="0"
                                                    max="100"
                                                    value="50"
                                                    HBox.hgrow="ALWAYS"/>

                                            <Label fx:id="skillLevelLabel"
                                                   text="50%"/>

                                        </HBox>

                                    </GridPane>

                                </content>

                            </TitledPane>


                            <!-- SKILL BUTTONS -->

                            <HBox spacing="10">

                                <Button fx:id="addSkillButton"
                                        text="Add Skill"
                                        onAction="#addSkill"/>

                                <Button fx:id="updateSkillButton"
                                        text="Update"
                                        onAction="#updateSkill"/>

                                <Button fx:id="deleteSkillButton"
                                        text="Delete"
                                        onAction="#deleteSkill"/>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Label fx:id="skillMessage"
                                       text="Select a skill to edit it."/>

                            </HBox>


                            <Separator/>


                            <!-- SKILL LIST & VISUALIZATION (PieChart) -->
                            <HBox spacing="15"
                                  maxWidth="Infinity">

                                <VBox spacing="8"
                                      prefWidth="380">

                                    <Label text="All Skills"/>

                                    <ListView fx:id="skillListView"
                                              prefHeight="240"
                                              VBox.vgrow="ALWAYS"/>

                                </VBox>

                                <VBox spacing="8"
                                      HBox.hgrow="ALWAYS">

                                    <Label text="Skills Category Visualization (PieChart)"/>

                                    <PieChart fx:id="skillsPieChart"
                                              prefHeight="240"
                                              legendVisible="true"
                                              labelsVisible="true"/>

                                </VBox>

                            </HBox>


                            <Separator/>


                            <!-- PROJECT SKILLS -->

                            <TitledPane text="Project Skills"
                                        expanded="true"
                                        maxWidth="Infinity">

                                <content>

                                    <VBox spacing="10">

                                        <padding>
                                            <Insets top="15"
                                                    right="15"
                                                    bottom="15"
                                                    left="15"/>
                                        </padding>


                                        <Label text="First select a project from the Projects page, then select a skill above."/>

                                        <Button fx:id="assignSkillButton"
                                                text="Assign Selected Skill To Selected Project"
                                                onAction="#assignSkillToProject"/>


                                        <Label text="Skills belonging to the selected project:"/>


                                        <ListView fx:id="projectSkillListView"
                                                  prefHeight="150"
                                                  maxWidth="Infinity"/>

                                    </VBox>

                                </content>

                            </TitledPane>

                        </VBox>


                        <!-- ================================================= -->
                        <!-- NOTES -->
                        <!-- ================================================= -->

                        <VBox fx:id="notesPage"
                              spacing="15"
                              maxWidth="Infinity">

                            <Label text="Notes"/>

                            <Label text="Create and manage notes for your portfolio."
                                   wrapText="true"/>


                            <Separator/>


                            <HBox spacing="15"
                                  maxWidth="Infinity">


                                <!-- NOTE LIST -->

                                <VBox spacing="10"
                                      prefWidth="280">

                                    <Label text="My Notes"/>

                                    <ListView fx:id="noteListView"
                                              prefHeight="400"
                                              VBox.vgrow="ALWAYS"/>

                                </VBox>


                                <!-- NOTE EDITOR -->

                                <VBox spacing="10"
                                      HBox.hgrow="ALWAYS">

                                    <Label text="Note Title"/>

                                    <TextField fx:id="noteTitleField"
                                               promptText="Enter note title"
                                               maxWidth="Infinity"/>


                                    <Label text="Note Content"/>

                                    <TextArea fx:id="noteContentArea"
                                              promptText="Write your note here..."
                                              wrapText="true"
                                              prefRowCount="14"
                                              maxWidth="Infinity"
                                              VBox.vgrow="ALWAYS"/>


                                    <HBox spacing="10">

                                        <Button fx:id="addNoteButton"
                                                text="Add Note"
                                                onAction="#addNote"/>

                                        <Button fx:id="updateNoteButton"
                                                text="Update"
                                                onAction="#updateNote"/>

                                        <Button fx:id="deleteNoteButton"
                                                text="Delete"
                                                onAction="#deleteNote"/>

                                    </HBox>

                                </VBox>

                            </HBox>

                        </VBox>


                        <!-- ================================================= -->
                        <!-- TASKS -->
                        <!-- ================================================= -->

                        <VBox fx:id="tasksPage"
                              spacing="15"
                              maxWidth="Infinity">

                            <Label text="Tasks"/>

                            <Label text="Track tasks related to your portfolio."
                                   wrapText="true"/>


                            <Separator/>


                            <HBox spacing="15"
                                  maxWidth="Infinity">


                                <!-- TASK LIST -->

                                <VBox spacing="10"
                                      prefWidth="320">

                                    <Label text="My Tasks"/>

                                    <HBox spacing="8"
                                          alignment="CENTER_LEFT">

                                        <Label text="Priority Filter:"/>

                                        <ChoiceBox fx:id="taskPriorityFilterChoice"
                                                   prefWidth="160"/>

                                    </HBox>

                                    <ListView fx:id="taskListView"
                                              prefHeight="350"
                                              VBox.vgrow="ALWAYS"/>

                                </VBox>


                                <!-- TASK EDITOR -->

                                <VBox spacing="12"
                                      HBox.hgrow="ALWAYS">

                                    <Label text="Task Title"/>

                                    <TextField fx:id="taskTitleField"
                                               promptText="Enter task title"
                                               maxWidth="Infinity"/>


                                    <HBox spacing="15"
                                          alignment="CENTER_LEFT">

                                        <Label text="Priority:"/>

                                        <ChoiceBox fx:id="taskPriorityChoice"
                                                   prefWidth="140"/>

                                        <Region HBox.hgrow="ALWAYS"/>

                                        <CheckBox fx:id="taskCompletedCheckBox"
                                                  text="Completed"/>

                                    </HBox>


                                    <HBox spacing="10">

                                        <Button fx:id="addTaskButton"
                                                text="Add Task"
                                                onAction="#addTask"/>

                                        <Button fx:id="updateTaskButton"
                                                text="Update"
                                                onAction="#updateTask"/>

                                        <Button fx:id="deleteTaskButton"
                                                text="Delete"
                                                onAction="#deleteTask"/>

                                    </HBox>


                                    <Separator/>


                                    <Button fx:id="toggleTaskButton"
                                            text="Mark Complete / Incomplete"
                                            onAction="#toggleTask"/>

                                </VBox>

                            </HBox>

                        </VBox>


                        <!-- ================================================= -->
                        <!-- API -->
                        <!-- ================================================= -->

                        <VBox fx:id="apiPage"
                              spacing="15"
                              maxWidth="Infinity">

                            <Label text="External API"/>

                            <Label text="HTTP Request + JSON Parsing"/>

                            <Button fx:id="fetchApiButton"
                                    text="Fetch API Data"
                                    onAction="#fetchApiData"/>

                            <Label fx:id="apiStatusLabel"
                                   text="Status: Ready"/>

                            <TextArea fx:id="apiResultArea"
                                      promptText="API response will appear here..."
                                      prefRowCount="12"
                                      wrapText="true"
                                      maxWidth="Infinity"/>

                            <ProgressBar fx:id="apiProgress"
                                         progress="0"
                                         maxWidth="Infinity"/>

                        </VBox>


                        <!-- ================================================= -->
                        <!-- SETTINGS -->
                        <!-- ================================================= -->

                        <VBox fx:id="settingsPage"
                              spacing="15"
                              maxWidth="Infinity">

                            <Label text="Settings"/>

                            <Label text="Application Settings"/>

                            <Separator/>

                            <Button text="Choose Profile Image"
                                    onAction="#chooseImage"/>

                            <Button text="Show About"
                                    onAction="#showAbout"/>

                            <Label text="DevFolio - Personal Portfolio Manager"
                                   wrapText="true"/>

                        </VBox>


                    </StackPane>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>